# === CLIENT-SIDE (akan diekspos ke browser) ===
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-key"
VITE_ELEARNING_URL="https://your-elearning-app.vercel.app/"
VITE_APP_INTERNAL_SECRET="your-random-shared-secret"

# === SERVER-SIDE ONLY (set di Vercel Dashboard, JANGAN pakai prefix VITE_) ===
# JWT_SECRET="your-jwt-secret"        → Set di Vercel Environment Variables
# GEMINI_API_KEY="your-gemini-key"    → Set di Vercel Environment Variables
# APP_INTERNAL_SECRET="your-random-shared-secret" → Harus sama dengan yang di atas
